{
  "info": {
    "name": "Student Management System",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" }
  ],
  "item": [
    {
      "name": "1. Add student (POST) - 201",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Rahul Sharma\",\n  \"email\": \"rahul.sharma@example.com\",\n  \"course\": \"Computer Science\",\n  \"age\": 21\n}"
        },
        "url": { "raw": "{{baseUrl}}/api/students", "host": ["{{baseUrl}}"], "path": ["api", "students"] }
      }
    },
    {
      "name": "1b. Add second student (POST) - 201",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Priya Singh\",\n  \"email\": \"priya.singh@example.com\",\n  \"course\": \"Computer Science\",\n  \"age\": 20\n}"
        },
        "url": { "raw": "{{baseUrl}}/api/students", "host": ["{{baseUrl}}"], "path": ["api", "students"] }
      }
    },
    {
      "name": "2. Get all students (GET) - 200",
      "request": {
        "method": "GET",
        "url": { "raw": "{{baseUrl}}/api/students", "host": ["{{baseUrl}}"], "path": ["api", "students"] }
      }
    },
    {
      "name": "3. Get student by ID (GET) - 200",
      "request": {
        "method": "GET",
        "url": { "raw": "{{baseUrl}}/api/students/1", "host": ["{{baseUrl}}"], "path": ["api", "students", "1"] }
      }
    },
    {
      "name": "4. Update student (PUT) - 200",
      "request": {
        "method": "PUT",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Rahul Sharma\",\n  \"email\": \"rahul.sharma@example.com\",\n  \"course\": \"Information Technology\",\n  \"age\": 22\n}"
        },
        "url": { "raw": "{{baseUrl}}/api/students/1", "host": ["{{baseUrl}}"], "path": ["api", "students", "1"] }
      }
    },
    {
      "name": "5. Get students by course (GET) - 200",
      "request": {
        "method": "GET",
        "url": { "raw": "{{baseUrl}}/api/students/course/Computer Science", "host": ["{{baseUrl}}"], "path": ["api", "students", "course", "Computer Science"] }
      }
    },
    {
      "name": "6. Delete student (DELETE) - 200",
      "request": {
        "method": "DELETE",
        "url": { "raw": "{{baseUrl}}/api/students/1", "host": ["{{baseUrl}}"], "path": ["api", "students", "1"] }
      }
    },
    {
      "name": "7. Get non-existent student (GET) - 404",
      "request": {
        "method": "GET",
        "url": { "raw": "{{baseUrl}}/api/students/999", "host": ["{{baseUrl}}"], "path": ["api", "students", "999"] }
      }
    },
    {
      "name": "8. Add invalid student (POST) - 400",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"\",\n  \"email\": \"not-an-email\",\n  \"course\": \"\",\n  \"age\": -5\n}"
        },
        "url": { "raw": "{{baseUrl}}/api/students", "host": ["{{baseUrl}}"], "path": ["api", "students"] }
      }
    }
  ]
}
